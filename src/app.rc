// The exe's icon and version information (Properties > Details), as the Python build's
// build/version_info.txt had them.
#include <winver.h>
#include "version.h"

IDI_ICON1 ICON "../assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION F1_VERSION_NUMBERS
 PRODUCTVERSION F1_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Kjerne"
            VALUE "FileDescription", "F1DockTimers - Formula 1 schedule and countdown"
            VALUE "FileVersion", F1_VERSION
            VALUE "InternalName", "F1DockTimers"
            VALUE "LegalCopyright", "Copyright (c) 2026 Kjerne. MIT License."
            VALUE "OriginalFilename", "F1DockTimers.exe"
            VALUE "ProductName", "F1DockTimers"
            VALUE "ProductVersion", F1_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
