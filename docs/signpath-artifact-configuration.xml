<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath: Project F1DockTimers > Artifact configurations > "initial".
     The GitHub artifact is a ZIP with the two release files; both get Authenticode signatures.
     product-name pins the file metadata to this project, as SignPath Foundation requires. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="F1DockTimers-*-portable.exe" product-name="F1DockTimers" max-matches="1">
      <authenticode-sign />
    </pe-file>
    <pe-file path="F1DockTimers-*-setup.exe" product-name="F1DockTimers" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
