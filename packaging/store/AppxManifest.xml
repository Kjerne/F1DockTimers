<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package of F1DockTimers. build-msix.ps1 fills in the $(...) values:
     IdentityName and Publisher must be copied from Partner Center (Product identity page). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="$(IdentityName)" Publisher="$(Publisher)" Version="$(Version)" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>F1DockTimers</DisplayName>
    <PublisherDisplayName>$(PublisherDisplayName)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Formula 1 schedule, standings, live timing and a session countdown in your Windows taskbar.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="F1DockTimers" Executable="F1DockTimers.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="F1DockTimers"
        Description="Formula 1 schedule, standings, live timing and a session countdown in your Windows taskbar."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="F1DockTimers" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" for the Store version; the user switches it in Settings > Apps > Startup.
             TaskId must match f1win/services/packaging.py. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="F1DockTimersStartup" Enabled="true" DisplayName="F1DockTimers" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Required for every classic desktop (Win32) app in the Store. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
